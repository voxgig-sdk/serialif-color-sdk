          }
          contract: {
            id: "GET /{color}"
            json: "{\"operationId\":\"getColorByPath\",\"parameters\":[{\"description\":\"Color value in Keyword (e.g., aquamarine), HEX (e.g., 55667788 without #), RGB (e.g., 85,102,119), RGBA (e.g., 85,102,119,0.53), HSL (e.g., 85,102,119), or HSLA (e.g., 85,102,119,0.53) format\",\"examples\":{\"hex\":{\"summary\":\"HEX format (without #)\",\"value\":\"55667788\"},\"keyword\":{\"summary\":\"Keyword format\",\"value\":\"aquamarine\"},\"rgb\":{\"summary\":\"RGB format (without rgb(), spaces)\",\"value\":\"85,102,119\"},\"rgba\":{\"summary\":\"RGBA format (without rgba(), spaces)\",\"value\":\"85,102,119,0.53\"}},\"in\":\"path\",\"name\":\"color\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"success\":{\"summary\":\"Successful color conversion\",\"value\":{\"base\":{\"hex\":{\"composition\":{\"alpha\":\"77\",\"blue\":\"5a\",\"green\":\"41\",\"red\":\"c4\"},\"value\":\"#c4415a77\"},\"hsla\":{\"composition\":{\"alpha\":0.46667,\"hue\":349,\"lightness\":51,\"saturation\":53},\"value\":\"hsla(349, 53%, 51%, 0.47)\"},\"hsla_raw\":{\"composition\":{\"alpha\":0.46667,\"hue\":348.54962,\"lightness\":51.17647,\"saturation\":52.61044},\"value\":\"hsla(348.54962, 52.61044%, 51.17647%, 0.47)\"},\"keyword\":\"\",\"rgba\":{\"composition\":{\"alpha\":0.46667,\"blue\":90,\"green\":65,\"red\":196},\"value\":\"rgba(196, 65, 90, 0.47)\"}},\"base_without_alpha\":{\"hex\":{\"composition\":{\"blue\":\"5a\",\"green\":\"41\",\"red\":\"c4\"},\"value\":\"#c4415a\"},\"hsl\":{\"composition\":{\"hue\":349,\"lightness\":51,\"saturation\":53},\"value\":\"hsl(349, 53%, 51%)\"},\"hsl_raw\":{\"composition\":{\"hue\":348.54962,\"lightness\":51.17647,\"saturation\":52.61044},\"value\":\"hsl(348.54962, 52.61044%, 51.17647%)\"},\"keyword\":\"\",\"rgb\":{\"composition\":{\"blue\":90,\"green\":65,\"red\":196},\"value\":\"rgb(196, 65, 90)\"}},\"base_without_alpha_contrasted_text\":{\"hex\":{\"composition\":{\"blue\":\"ff\",\"green\":\"ff\",\"red\":\"ff\"},\"value\":\"#ffffff\"},\"hsl\":{\"composition\":{\"hue\":0,\"lightness\":100,\"saturation\":0},\"value\":\"hsl(0, 0%, 100%)\"},\"hsl_raw\":{\"composition\":{\"hue\":0,\"lightness\":100,\"saturation\":0},\"value\":\"hsl(0, 0%, 100%)\"},\"keyword\":\"white\",\"rgb\":{\"composition\":{\"blue\":255,\"green\":255,\"red\":255},\"value\":\"rgb(255, 255, 255)\"}},\"complementary\":{\"hex\":{\"composition\":{\"alpha\":\"77\",\"blue\":\"a5\",\"green\":\"be\",\"red\":\"3b\"},\"value\":\"#3bbea577\"},\"hsla\":{\"composition\":{\"alpha\":0.46667,\"hue\":169,\"lightness\":49,\"saturation\":53},\"value\":\"hsla(169, 53%, 49%, 0.47)\"},\"hsla_raw\":{\"composition\":{\"alpha\":0.46667,\"hue\":168.54962,\"lightness\":48.82353,\"saturation\":52.61044},\"value\":\"hsla(168.54962, 52.61044%, 48.82353%, 0.47)\"},\"keyword\":\"\",\"rgba\":{\"composition\":{\"alpha\":0.46667,\"blue\":165,\"green\":190,\"red\":59},\"value\":\"rgba(59, 190, 165, 0.47)\"}},\"complementary_without_alpha\":{\"hex\":{\"composition\":{\"blue\":\"a5\",\"green\":\"be\",\"red\":\"3b\"},\"value\":\"#3bbea5\"},\"hsl\":{\"composition\":{\"hue\":169,\"lightness\":49,\"saturation\":53},\"value\":\"hsl(169, 53%, 49%)\"},\"hsl_raw\":{\"composition\":{\"hue\":168.54962,\"lightness\":48.82353,\"saturation\":52.61044},\"value\":\"hsl(168.54962, 52.61044%, 48.82353%)\"},\"keyword\":\"\",\"rgb\":{\"composition\":{\"blue\":165,\"green\":190,\"red\":59},\"value\":\"rgb(59, 190, 165)\"}},\"complementary_without_alpha_contrasted_text\":{\"hex\":{\"composition\":{\"blue\":\"00\",\"green\":\"00\",\"red\":\"00\"},\"value\":\"#000000\"},\"hsl\":{\"composition\":{\"hue\":0,\"lightness\":0,\"saturation\":0},\"value\":\"hsl(0, 0%, 0%)\"},\"hsl_raw\":{\"composition\":{\"hue\":0,\"lightness\":0,\"saturation\":0},\"value\":\"hsl(0, 0%, 0%)\"},\"keyword\":\"black\",\"rgb\":{\"composition\":{\"blue\":0,\"green\":0,\"red\":0},\"value\":\"rgb(0, 0, 0)\"}},\"grayscale\":{\"hex\":{\"composition