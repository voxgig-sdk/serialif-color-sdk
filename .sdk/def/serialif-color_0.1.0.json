{
  "openapi": "3.0.3",
  "info": {
    "title": "Serialif Color API",
    "description": "Get requested color, complementary color, grayscale, and corresponding text color in different formats. Supports Keyword, HEX, RGB/RGBA, and HSL/HSLA color formats.",
    "version": "1.0.0",
    "contact": {
      "name": "Serialif",
      "url": "https://color.serialif.com/"
    }
  },
  "servers": [
    {
      "url": "https://color.serialif.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/{color}": {
      "get": {
        "summary": "Get color information by direct color value",
        "description": "Returns the requested color, its complementary and grayscale versions in multiple formats, along with contrasted text colors. Accepts color in Keyword, HEX (without #), RGB, RGBA, HSL, or HSLA format as path parameter.",
        "operationId": "getColorByPath",
        "parameters": [
          {
            "name": "color",
            "in": "path",
            "required": true,
            "description": "Color value in Keyword (e.g., aquamarine), HEX (e.g., 55667788 without #), RGB (e.g., 85,102,119), RGBA (e.g., 85,102,119,0.53), HSL (e.g., 85,102,119), or HSLA (e.g., 85,102,119,0.53) format",
            "schema": {
              "type": "string"
            },
            "examples": {
              "keyword": {
                "summary": "Keyword format",
                "value": "aquamarine"
              },
              "hex": {
                "summary": "HEX format (without #)",
                "value": "55667788"
              },
              "rgb": {
                "summary": "RGB format (without rgb(), spaces)",
                "value": "85,102,119"
              },
              "rgba": {
                "summary": "RGBA format (without rgba(), spaces)",
                "value": "85,102,119,0.53"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with color information",
