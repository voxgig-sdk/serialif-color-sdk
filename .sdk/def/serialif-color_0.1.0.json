    "/": {
      "get": {
        "summary": "Get color information by query parameter",
        "description": "Returns the requested color, its complementary and grayscale versions in multiple formats, along with contrasted text colors. Accepts color via query parameters in Keyword, HEX, RGB, RGBA, HSL, or HSLA format.",
        "operationId": "getColorByQuery",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "Color keyword (e.g., aquamarine)",
            "schema": {
              "type": "string"
            },
            "example": "aquamarine"
          },
          {
            "name": "hex",
            "in": "query",
            "required": false,
            "description": "HEX color value without # (e.g., 55667788)",
            "schema": {
              "type": "string"
            },
            "example": "55667788"
          },
          {
            "name": "rgb",
            "in": "query",
            "required": false,
            "description": "RGB or RGBA color values separated by commas (e.g., 85,102,119 or 85,102,119,0.53)",
            "schema": {
              "type": "string"
            },
            "example": "85,102,119"
          },
          {
            "name": "rgba",
            "in": "query",
            "required": false,
            "description": "RGBA color values separated by commas (e.g., 85,102,119,0.53)",
            "schema": {
              "type": "string"
            },
            "example": "85,102,119,0.53"
          },
          {
            "name": "hsl",
            "in": "query",
            "required": false,
            "description": "HSL or HSLA color values separated by commas (e.g., 85,102,119 or 85,102,119,0.53)",
            "schema": {
              "type": "string"
            },
            "example": "85,102,119"
          },
          {
            "name": "hsla",
            "in": "query",
            "required": false,
            "description": "HSLA color values separated by commas (e.g., 85,102,119,0.53)",
            "schema": {
              "type": "string"
            },
            "example": "85,102,119,0.53"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with color information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid color format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
